{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IntentRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["session_id", "raw_text"],
  "properties": {
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "raw_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    }
  }
}
