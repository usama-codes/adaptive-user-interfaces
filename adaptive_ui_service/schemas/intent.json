{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Intent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action",
    "target_capability_id",
    "destination",
    "confidence",
    "clarification_question"
  ],
  "properties": {
    "action": {
      "type": "string",
      "enum": ["move", "hide", "show", "reorder", "unsupported", "clarify"]
    },
    "target_capability_id": {
      "type": ["string", "null"]
    },
    "destination": {
      "type": ["string", "null"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "clarification_question": {
      "type": ["string", "null"]
    }
  }
}
